[Unit]
Description=syncdoc.clive.io service
After=network.target syncdoc.clive.io-build.service
Requires=syncdoc.clive.io-build.service
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
User=www
Environment="PORT=3001"
ExecStart=/home/www/bin/syncdoc

[Install]
WantedBy=multi-user.target
